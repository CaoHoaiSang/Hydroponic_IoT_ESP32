{
  "name": "hydroponic-mqtt-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Edge Server MQTT backend for Hydroponic_IoT_ESP32 core phase.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "node --test",
    "frontend:install": "npm --prefix ../frontend ci",
    "frontend:build": "npm --prefix ../frontend run build",
    "frontend:test": "npm --prefix ../frontend test",
    "frontend:verify": "npm --prefix ../frontend run verify",
    "build:local-ui": "npm run frontend:install && npm run frontend:build",
    "stage0:test": "node staging/runStage0Checks.js",
    "stage1:test": "node staging/stage1/runStage1PreflightChecks.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.12.0",
    "mqtt": "^5.10.3"
  }
}
