NODE_ENV=staging
SERVICE_NAME=hydroponic-stage1-preflight-backend
HTTP_HOST=127.0.0.1
HTTP_PORT=3101
MONGO_URI=mongodb://127.0.0.1:27019
MONGO_DB_NAME=hydroponic_stage1_preflight
MQTT_URL=mqtt://127.0.0.1:18885
MQTT_USERNAME=RUNTIME_ONLY
MQTT_PASSWORD=RUNTIME_ONLY
MQTT_TOPIC_SENSOR=stage1/hydroponic/device001/sensor
MQTT_TOPIC_PUMP_CMD=stage1/hydroponic/device001/pump/cmd
MQTT_TOPIC_PUMP_STATUS=stage1/hydroponic/device001/pump/status
# RESERVED/UNUSED in Stage 1 Preflight; no alert publish or subscription path is enabled.
MQTT_TOPIC_ALERT=stage1/hydroponic/device001/alert
SHADOW_MODE_ENABLED=true
PUMP_COMMANDS_DISABLED=true
