# Copy .env.example to .env before running.
# Do not commit .env.
#
# Use MQTT_URL=mqtt://127.0.0.1:1883 if Mosquitto runs on the same laptop.
# Use MQTT_URL=mqtt://<broker-ip>:1883 if Mosquitto runs on another machine.
# HTTP_PORT is the REST API port.
# Use http://localhost:3001 for local testing.
# CORS_ORIGIN=* is acceptable for local development only.

HTTP_PORT=3001
CORS_ORIGIN=*

MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=hydroponic_iot

MQTT_TOPIC_SENSOR=hydroponic/device001/sensor
MQTT_TOPIC_PUMP_CMD=hydroponic/device001/pump/cmd
MQTT_TOPIC_PUMP_STATUS=hydroponic/device001/pump/status
SHADOW_MODE_ENABLED=false

SERVICE_NAME=hydroponic-mqtt-backend

# Initial conservative software quality thresholds. Validate with real logs.
TDS_STABILITY_REQUIRED_SAMPLES=3
TDS_STABILITY_WINDOW_MS=120000
TDS_STABILITY_MIN_SPREAD_PPM=20
TDS_STABILITY_MAX_SPREAD_PERCENT=0.03
TDS_CONTROL_MAX_AGE_MS=120000
